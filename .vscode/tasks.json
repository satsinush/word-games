{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "mingw-debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Debug",
                "--config",
                "Debug"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Configure and Build (Debug)",
            "dependsOn": [
                "Configure (Debug)",
                "Build (Debug)"
            ],
            "dependsOrder": "sequence"
        },
        {
            "label": "Configure (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "mingw-release"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/Release",
                "--config",
                "Release"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Configure and Build (Release)",
            "dependsOn": [
                "Configure (Release)",
                "Build (Release)"
            ],
            "dependsOrder": "sequence"
        }
    ]
}