{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Active Target",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                // This variable automatically finds the correct build dir (Debug or Release)
                "${command:cmake.buildDirectory}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}