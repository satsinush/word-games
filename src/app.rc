// Windows Resource File for Puzzle++
#include <windows.h>

// Application icon - will be copied to build directory
IDI_ICON1 ICON "icon.ico"

// Version information
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Puzzle++ Project"
            VALUE "FileDescription", "Advanced word game and puzzle solver"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "p++"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "p++.exe"
            VALUE "ProductName", "Puzzle++"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END