            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/mingw-core",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_GUI": "OFF",
                "BUILD_TESTING": "OFF",
                "BUILD_BENCHMARKS": "OFF",
                "BUILD_TRACY": "OFF"
            }
        },
        {
            "name": "msvc-debug",
            "displayName": "msvc-debug",
