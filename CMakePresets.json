{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "mingw-debug",
            "displayName": "mingw-debug",
            "description": "Builds for Debug with the MinGW-w64 compiler.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/mingw-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/mingw_64",
                "BUILD_GUI": "ON",
                "BUILD_TESTING": "ON",
                "BUILD_BENCHMARKS": "ON",
                "BUILD_TRACY": "OFF"
            }
        },
        {
            "name": "mingw-release",
            "displayName": "mingw-release",
            "description": "Builds for Release with the MinGW-w64 compiler.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/mingw-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/mingw_64",
                "BUILD_GUI": "ON",
                "BUILD_TESTING": "OFF",
                "BUILD_BENCHMARKS": "OFF",
                "BUILD_TRACY": "OFF"
            }
        },
        {
            "name": "mingw-core",
            "displayName": "mingw-core",
